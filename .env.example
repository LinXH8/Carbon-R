# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Keep uv pointed at the project's named virtualenv rather than a bare .venv.
UV_PROJECT_ENVIRONMENT=.venv-carbon-r

# --- Model provider (vision-capable; used for document extraction) ---
OPENAI_API_KEY=sk-proj-...
# Set to a model id that exists in YOUR account: `make models`.
# Use a dated snapshot, not a floating alias, so eval numbers stay reproducible.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Methodology retrieval (search_methodology). Every stored chunk records the model that
# embedded it, and a search only ranks chunks from this one: changing it means re-ingesting.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Postgres ---
# Supabase: Project Settings -> Database -> Connection string -> URI -> Session pooler.
# Percent-encode special characters in the password (@ -> %40, # -> %23, ...).
# Local docker compose alternative:
#   postgresql://carbon_r:carbon_r@localhost:5433/carbon_r
DATABASE_URL=

# --- Jurisdiction constants ---
# Singapore GST. Verified from IRAS's e-Tax guide: 9% since 1 Jan 2024. See SOURCES.md.
GST_RATE=0.09
