{# Layout D - the HOLDOUT layout (spec 6.1). Never looked at while tuning prompts; scored
   separately. A sidebar layout: account facts down the left, charges on the right, long
   month names, and its own wording ("Energy consumed", "Charges payable").
   No arithmetic, no literal dates: every value comes from render.bill_context(). #}
<!-- {{ doc_id }} / layout {{ layout_id }} / {{ generator_version }} / seed {{ generator_seed }} -->
{% from "_quirks.html.j2" import gst_headline, account_summary, credit_row %}
<style>
  @page { size: A4; margin: 12mm; }
  body { font-family: Verdana, Geneva, sans-serif; font-size: 8.4pt; color: #1d1d1d; line-height: 1.45; }
  .notice { border: 1.2pt dashed #8a6d00; background: #fffbe8; color: #6b5500; padding: 4pt 6pt; font-size: 7.2pt; }
  .band { background: #4b2e83; color: white; padding: 8pt 10pt; margin-top: 8pt; }
  .band .name { font-size: 13pt; font-weight: 700; }
  .wrap { display: flex; gap: 0; margin-top: 0; }
  .side { width: 36%; background: #f1eef8; padding: 9pt 10pt; }
  .side h4 { margin: 8pt 0 2pt; font-size: 7.2pt; color: #4b2e83; text-transform: uppercase; }
  .main { flex: 1; padding: 9pt 0 0 12pt; }
  table { width: 100%; border-collapse: collapse; }
  td, th { padding: 3pt 2pt; border-bottom: .5pt solid #ddd; text-align: left; }
  th { color: #4b2e83; font-size: 7.4pt; }
  .num { text-align: right; }
  .pay { margin-top: 8pt; font-size: 11pt; font-weight: 700; color: #4b2e83; text-align: right; }
  footer { margin-top: 14pt; font-size: 7pt; color: #777; }
</style>

<div class="notice">{{ notice }}</div>
<div class="band">
  <div class="name">{{ vendor_name }}</div>
  {{ vendor_address }} &middot; Registration {{ vendor_uen }} &middot; {{ vendor_support }}
</div>

<div class="wrap">
  <div class="side">
    <h4>Bill to</h4>{{ customer_name }}<br>{{ customer_address }}
    <h4>Account number</h4>{{ account_number }}
    <h4>Date of bill</h4>{{ document_date }}
    <h4>Service period</h4>{{ period_start }} to {{ period_end }}<br>{{ days_in_period }} days
    <h4>Your plan</h4>{{ tariff_plan_name }}<br>Code {{ tariff_plan_code }}<br>{{ tension }} supply
    <h4>Meter</h4>{{ meter_number }} ({{ reading_basis }} read)
  </div>
  <div class="main">
    {{ gst_headline(gst_inclusive_display, total, currency) }}
    <table>
      <tr><th>Meter readings</th><th class="num">{{ consumption_unit }}</th></tr>
      <tr><td>Start of period</td><td class="num">{{ previous_reading }}</td></tr>
      <tr><td>End of period</td><td class="num">{{ current_reading }}</td></tr>
      <tr><td><b>Energy consumed</b></td><td class="num"><b>{{ consumption }}</b></td></tr>
    </table>
    <table style="margin-top: 9pt;">
      <tr><th>Charges</th><th class="num">Basis</th><th class="num">{{ currency }}</th></tr>
      <tr><td>Energy</td><td class="num">{{ consumption }} {{ consumption_unit }} &times; {{ tariff_cents_per_kwh }}&cent;/kWh</td><td class="num">{{ energy_charge }}</td></tr>
      <tr><td>Fixed monthly charge</td><td class="num"></td><td class="num">{{ fixed_charge }}</td></tr>
      {{ credit_row(credit, 1) }}
      <tr><td>{{ "Current charges" if gst_inclusive_display else "Charges excluding GST" }}</td><td></td><td class="num">{{ subtotal }}</td></tr>
      <tr><td>Goods and Services Tax ({{ gst_percent }}%)</td><td></td><td class="num">{{ gst_amount }}</td></tr>
    </table>
    <div class="pay">Charges payable: {{ currency }} {{ total }}</div>
    {{ account_summary(summary, currency) }}
  </div>
</div>

<footer>{{ notice }} {{ generator_version }}, seed {{ generator_seed }}.</footer>
