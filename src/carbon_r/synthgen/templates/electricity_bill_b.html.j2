{# Layout B - label/value blocks rather than tables, the amount payable in a box at the
   TOP, day-first slashed dates, and different wording ("Units used", "Amount payable").
   No arithmetic and no literal dates: every value comes from render.bill_context(). #}
<!-- {{ doc_id }} / layout {{ layout_id }} / {{ generator_version }} / seed {{ generator_seed }} -->
{% from "_quirks.html.j2" import gst_headline, account_summary, credit_row %}
<style>
  @page { size: A4; margin: 18mm 16mm; }
  body { font-family: Georgia, "Times New Roman", serif; font-size: 9.6pt; color: #222; line-height: 1.5; }
  .notice { border: 1.2pt dashed #8a6d00; background: #fffbe8; color: #6b5500; padding: 5pt 7pt;
            font-family: Arial, sans-serif; font-size: 7.6pt; margin-bottom: 12pt; }
  .top { display: flex; justify-content: space-between; align-items: flex-end; }
  .brand { font-size: 17pt; color: #2d5a27; font-weight: 700; }
  .meta { font-size: 7.8pt; color: #666; }
  .due { border: 1.4pt solid #2d5a27; padding: 6pt 10pt; text-align: right; }
  .due .label { font-size: 7.6pt; color: #2d5a27; text-transform: uppercase; letter-spacing: .08em; }
  .due .value { font-size: 16pt; font-weight: 700; }
  .grid { display: flex; gap: 18pt; margin-top: 14pt; }
  .col { flex: 1; }
  .row { display: flex; justify-content: space-between; border-bottom: .4pt dotted #bbb; padding: 2pt 0; }
  .row span:first-child { color: #555; }
  h2 { font-size: 9pt; color: #2d5a27; margin: 14pt 0 3pt; border-bottom: 1pt solid #2d5a27; }
  table { width: 100%; border-collapse: collapse; }
  td { padding: 3pt 0; border-bottom: .4pt dotted #bbb; }
  td.num { text-align: right; }
  footer { margin-top: 18pt; font-size: 7.2pt; color: #777; border-top: .4pt solid #ccc; padding-top: 5pt; }
</style>

<div class="notice">{{ notice }}</div>

<div class="top">
  <div>
    <div class="brand">{{ vendor_name }}</div>
    <div class="meta">Co. Reg. / UEN: {{ vendor_uen }}<br>{{ vendor_address }} &middot; {{ vendor_support }}</div>
  </div>
  <div class="due">
    <div class="label">Amount payable</div>
    <div class="value">{{ currency }} {{ total }}</div>
  </div>
</div>

{{ gst_headline(gst_inclusive_display, total, currency) }}

<div class="grid">
  <div class="col">
    <h2>Customer</h2>
    <div>{{ customer_name }}</div>
    <div>{{ customer_address }}</div>
    <div class="row"><span>Account</span><span>{{ account_number }}</span></div>
    <div class="row"><span>Tax invoice date</span><span>{{ document_date }}</span></div>
  </div>
  <div class="col">
    <h2>Supply</h2>
    <div class="row"><span>Period from</span><span>{{ period_start }}</span></div>
    <div class="row"><span>Period to</span><span>{{ period_end }}</span></div>
    <div class="row"><span>Number of days</span><span>{{ days_in_period }}</span></div>
    <div class="row"><span>Price plan</span><span>{{ tariff_plan_name }}</span></div>
    <div class="row"><span>Plan code</span><span>{{ tariff_plan_code }}</span></div>
    <div class="row"><span>Voltage</span><span>{{ tension }}</span></div>
  </div>
</div>

<h2>Meter {{ meter_number }} &middot; reading type: {{ reading_basis }}</h2>
<div class="row"><span>Opening reading</span><span>{{ previous_reading }} {{ consumption_unit }}</span></div>
<div class="row"><span>Closing reading</span><span>{{ current_reading }} {{ consumption_unit }}</span></div>
<div class="row"><span><strong>Units used</strong></span><span><strong>{{ consumption }} {{ consumption_unit }}</strong></span></div>

{{ account_summary(summary, currency, "Your account") }}

<h2>How this bill is made up ({{ currency }})</h2>
<table>
  <tr><td>Energy, {{ consumption }} {{ consumption_unit }} at {{ tariff_cents_per_kwh }} cents per kWh</td><td></td><td class="num">{{ energy_charge }}</td></tr>
  <tr><td>Service charge</td><td></td><td class="num">{{ fixed_charge }}</td></tr>
  {{ credit_row(credit, 1) }}
  <tr><td>{{ "Current charges" if gst_inclusive_display else "Total before GST" }}</td><td></td><td class="num">{{ subtotal }}</td></tr>
  <tr><td>GST at {{ gst_percent }}%</td><td></td><td class="num">{{ gst_amount }}</td></tr>
  <tr><td><strong>Amount payable</strong></td><td></td><td class="num"><strong>{{ total }}</strong></td></tr>
</table>

<footer>{{ notice }} Generated by {{ generator_version }}, seed {{ generator_seed }}.</footer>
