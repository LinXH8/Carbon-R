{# Layout C - a dense, monospaced statement in the style of a utility's printed run: upper
   case labels, ISO dates, the total at the bottom LEFT. No arithmetic, no literal dates. #}
<!-- {{ doc_id }} / layout {{ layout_id }} / {{ generator_version }} / seed {{ generator_seed }} -->
{% from "_quirks.html.j2" import gst_headline, account_summary, credit_row %}
<style>
  @page { size: A4; margin: 14mm 14mm; }
  body { font-family: "Courier New", Courier, monospace; font-size: 8.8pt; color: #111; line-height: 1.35; }
  .notice { border: 1pt dashed #8a6d00; background: #fffbe8; color: #6b5500; padding: 4pt 6pt;
            font-size: 7.4pt; margin-bottom: 10pt; }
  .head { border-top: 2pt solid #111; border-bottom: 2pt solid #111; padding: 5pt 0; }
  .head b { font-size: 12pt; }
  table { width: 100%; border-collapse: collapse; margin-top: 8pt; }
  td, th { padding: 1.6pt 3pt; text-align: left; vertical-align: top; }
  th { border-bottom: 1pt solid #111; font-weight: 700; }
  td.num, th.num { text-align: right; }
  .kv td:first-child { width: 38%; }
  .total { margin-top: 10pt; border: 1.6pt solid #111; display: inline-block; padding: 4pt 8pt; font-size: 11pt; }
  footer { margin-top: 14pt; font-size: 7pt; border-top: 1pt solid #111; padding-top: 4pt; }
</style>

<div class="notice">{{ notice }}</div>

<div class="head">
  <b>{{ vendor_name }}</b> &nbsp; UEN {{ vendor_uen }}<br>
  {{ vendor_address }} / {{ vendor_support }}<br>
  ELECTRICITY BILL &middot; TAX INVOICE
</div>

<table class="kv">
  <tr><td>BILL DATE</td><td>{{ document_date }}</td></tr>
  <tr><td>ACCOUNT</td><td>{{ account_number }}</td></tr>
  <tr><td>CUSTOMER</td><td>{{ customer_name }}</td></tr>
  <tr><td>PREMISES</td><td>{{ customer_address }}</td></tr>
  <tr><td>BILLING PERIOD</td><td>{{ period_start }} TO {{ period_end }} ({{ days_in_period }} DAYS)</td></tr>
  <tr><td>TARIFF</td><td>{{ tariff_plan_code }} / {{ tariff_plan_name }} / {{ tension }}</td></tr>
</table>

{{ gst_headline(gst_inclusive_display, total, currency, "CURRENT CHARGES INCL GST") }}

<table>
  <tr><th>METER NO</th><th>READ</th><th class="num">LAST</th><th class="num">THIS</th><th class="num">UNITS BILLED ({{ consumption_unit }})</th></tr>
  <tr><td>{{ meter_number }}</td><td>{{ reading_basis }}</td><td class="num">{{ previous_reading }}</td><td class="num">{{ current_reading }}</td><td class="num">{{ consumption }}</td></tr>
</table>

<table>
  <tr><th>CHARGE</th><th class="num">QTY</th><th class="num">RATE C/KWH</th><th class="num">{{ currency }}</th></tr>
  <tr><td>ENERGY</td><td class="num">{{ consumption }} {{ consumption_unit }}</td><td class="num">{{ tariff_cents_per_kwh }}</td><td class="num">{{ energy_charge }}</td></tr>
  <tr><td>SERVICE CHARGE</td><td class="num"></td><td class="num"></td><td class="num">{{ fixed_charge }}</td></tr>
  {{ credit_row(credit, 2) }}
  <tr><td>{{ "CURRENT CHARGES" if gst_inclusive_display else "NET AMOUNT" }}</td><td></td><td></td><td class="num">{{ subtotal }}</td></tr>
  <tr><td>GST {{ gst_percent }}%</td><td></td><td></td><td class="num">{{ gst_amount }}</td></tr>
</table>

{{ account_summary(summary, currency, "ACCOUNT SUMMARY") }}

<div class="total">TOTAL THIS BILL {{ currency }} {{ total }}</div>

<footer>{{ notice }}<br>{{ generator_version }} / SEED {{ generator_seed }}</footer>
