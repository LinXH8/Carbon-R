{# Layout A for LPG invoices - the only layout in Tier 2 Block 1. Block 2 adds more and
   holds one back as a never-tuned-on evaluation layout.

   No arithmetic and no literal dates in here: every value is a pre-formatted string from
   render.lpg_context(), built from an LPGInvoice that already passed its validator.

   Note what this layout does NOT print: a total weight of gas. The delivery line gives a
   cylinder count and a cylinder size, and the kg has to be computed from them. That is
   deliberate - it is the `lpg_cylinders` case, and pricing per cylinder is simply how
   this invoice works. #}
<!-- {{ doc_id }} / layout {{ layout_id }} / {{ generator_version }} / seed {{ generator_seed }} -->
<style>
  @page { size: A4; margin: 16mm 14mm; }
  body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 9.5pt;
         color: #1a1a1a; line-height: 1.45; }
  .notice { border: 1.2pt dashed #8a6d00; background: #fffbe8; color: #6b5500;
            padding: 5pt 7pt; font-size: 7.6pt; letter-spacing: .02em; margin-bottom: 11pt; }
  header { display: flex; justify-content: space-between; align-items: flex-start;
           border-bottom: 2pt solid #7a3c12; padding-bottom: 7pt; }
  .vendor { font-size: 14pt; font-weight: 700; color: #7a3c12; letter-spacing: -.01em; }
  .vendor-meta { font-size: 7.8pt; color: #6b6158; margin-top: 2pt; }
  .doctype { text-align: right; font-size: 7.8pt; color: #6b6158; }
  .doctype strong { display: block; font-size: 11pt; color: #7a3c12; letter-spacing: .06em; }
  .panels { display: flex; gap: 14pt; margin: 11pt 0 0; }
  .panel { flex: 1; }
  .panel h2 { font-size: 7.4pt; text-transform: uppercase; letter-spacing: .09em;
              color: #6b6158; margin: 0 0 3pt; font-weight: 600; }
  .panel .body { font-size: 9pt; }
  dl { margin: 0; display: grid; grid-template-columns: auto 1fr; column-gap: 8pt; row-gap: 1pt; }
  dt { color: #6b6158; font-size: 8.4pt; }
  dd { margin: 0; font-size: 8.4pt; text-align: right; font-variant-numeric: tabular-nums; }
  table { width: 100%; border-collapse: collapse; margin-top: 13pt; }
  th { font-size: 7.4pt; text-transform: uppercase; letter-spacing: .08em; color: #6b6158;
       text-align: left; border-bottom: .8pt solid #d8cfc5; padding: 0 0 3pt; font-weight: 600; }
  th.num, td.num { text-align: right; font-variant-numeric: tabular-nums; }
  td { padding: 4.5pt 0; border-bottom: .4pt solid #efe9e2; }
  tr.sum td { border-bottom: none; padding: 2.5pt 0; }
  tr.sum td.label { text-align: right; color: #6b6158; }
  tr.total td { border-top: 1.2pt solid #7a3c12; font-weight: 700; font-size: 11pt;
                color: #7a3c12; padding-top: 5pt; }
  .delivery { margin-top: 13pt; }
  .note { margin-top: 9pt; font-size: 7.8pt; color: #6b6158; }
  footer { margin-top: 15pt; border-top: .4pt solid #efe9e2; padding-top: 6pt;
           font-size: 7.2pt; color: #8a8178; }
</style>

<div class="notice">{{ notice }}</div>

<header>
  <div>
    <div class="vendor">{{ vendor_name }}</div>
    <div class="vendor-meta">
      UEN {{ vendor_uen }} &middot; {{ vendor_address }}<br>
      {{ vendor_support }}
    </div>
  </div>
  <div class="doctype">
    <strong>TAX INVOICE</strong>
    Liquefied petroleum gas supply<br>
    Reference {{ doc_id }}
  </div>
</header>

<div class="panels">
  <div class="panel">
    <h2>Delivered to</h2>
    <div class="body">
      <strong>{{ customer_name }}</strong><br>
      {{ customer_address }}
    </div>
  </div>
  <div class="panel">
    <h2>Invoice details</h2>
    <dl>
      <dt>Invoice no</dt><dd>{{ invoice_number }}</dd>
      <dt>Account no</dt><dd>{{ account_number }}</dd>
      <dt>Invoice date</dt><dd>{{ document_date }}</dd>
      <dt>Supply period</dt><dd>{{ period_start }} &ndash; {{ period_end }}</dd>
      <dt>Days</dt><dd>{{ days_in_period }}</dd>
      <dt>Price list</dt><dd>{{ price_list_code }}</dd>
    </dl>
  </div>
</div>

<div class="delivery">
  <table>
    <thead>
      <tr>
        <th>Delivery</th>
        <th class="num">Cylinders</th>
        <th class="num">Size</th>
        <th class="num">Price each</th>
        <th class="num">Amount ({{ currency }})</th>
      </tr>
    </thead>
    <tbody>
      {% for line in cylinder_lines %}
      <tr>
        <td>LPG cylinder, {{ line.size_kg }} kg</td>
        <td class="num">{{ line.count }}</td>
        <td class="num">{{ line.size_kg }} kg</td>
        <td class="num">{{ line.price_per_cylinder }}</td>
        <td class="num">{{ line.amount }}</td>
      </tr>
      {% endfor %}
      <tr>
        <td>Delivery charge</td>
        <td class="num"></td>
        <td class="num"></td>
        <td class="num"></td>
        <td class="num">{{ delivery_charge }}</td>
      </tr>
      <tr>
        <td>Cylinder rental</td>
        <td class="num">{{ cylinder_count }}</td>
        <td class="num"></td>
        <td class="num">{{ rental_per_cylinder }}</td>
        <td class="num">{{ rental_charge }}</td>
      </tr>
      <tr>
        <td>Empty cylinders collected</td>
        <td class="num">{{ returned_cylinders }}</td>
        <td class="num"></td>
        <td class="num"></td>
        <td class="num">&mdash;</td>
      </tr>
      <tr class="sum">
        <td class="label" colspan="4">Subtotal</td>
        <td class="num">{{ subtotal }}</td>
      </tr>
      <tr class="sum">
        <td class="label" colspan="4">GST {{ gst_percent }}%</td>
        <td class="num">{{ gst_amount }}</td>
      </tr>
      <tr class="total">
        <td colspan="4">Total payable</td>
        <td class="num">{{ currency }} {{ total }}</td>
      </tr>
    </tbody>
  </table>
</div>

<p class="note">
  Cylinder rental is charged per cylinder on site and is not a supply of gas. Deposits on
  cylinders are refundable on return of the cylinder in serviceable condition.
</p>

<footer>
  {{ vendor_name }} &middot; UEN {{ vendor_uen }} &middot; price list {{ price_list_code }}<br>
  {{ notice }}
</footer>
