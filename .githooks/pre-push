#!/bin/sh
# Blocks a push that would publish a real peer figure outside data/peer_disclosures_verified.json
# (CLAUDE.md rule 4). Git runs this before every push once `make hooks` has pointed
# core.hooksPath here; CI runs the same check on what was pushed.
#
# For each ref being pushed, the commits checked are the ones the remote does not have yet:
# remote_sha..local_sha, or, for a new branch, everything since its merge base with
# origin/main. The working tree is checked too (conservative: it is not being pushed).
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue  # deleting a branch publishes nothing
    if [ "$remote_sha" = "$zero" ]; then
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=origin/main
    else
        base=$remote_sha
    fi
    echo "pre-push: leak check for $remote_ref ($base..$local_sha)" >&2
    UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-.venv-carbon-r}" \
        uv run --quiet python scripts/draft_peer_disclosures.py leak-check \
        --base "$base" --head "$local_sha" >&2 || status=1
done
if [ "$status" -ne 0 ]; then
    echo "pre-push: BLOCKED - a peer figure would be published outside the verified file." >&2
    echo "pre-push: remove it, or record a reviewed coincidence in data/leak_check_coincidences.json." >&2
fi
exit "$status"
