# Secrets
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
.venv*/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Source documents: never committed.
# EMA / GHG Protocol / DESNZ / EPA material is third-party and not ours to
# redistribute. Provenance lives in SOURCES.md; the files stay local.
# Excluding the *contents* rather than the directory itself, so that the .gitkeep
# negations below can still apply: git does not descend into an excluded directory.
data/raw/*
data/generated/*
data/uploads/*
!data/raw/.gitkeep
!data/generated/.gitkeep
!data/uploads/.gitkeep

# The retrieval eval's anchor quotes are verbatim GHG Protocol text, which its terms do not
# let us publish. Only their hashes are committed (data/evals/methodology_questions.json).
data/evals/local/

# Belt-and-braces: no third-party document ever enters the repo by accident,
# whatever directory it lands in.
*.pdf
*.xlsx
*.xls

# Third-party reference material: distilled from Apple's WWDC design talks, used as the
# design brief for the Tier 1 Block 5 interface. Not ours to redistribute, same as the
# source documents above. The reasoning it led to is recorded in TIER1_BLOCK5.md instead.
apple-design/

# Personal working notes: the build log and the dated plan. These track the author's
# progress rather than the project, and carry career notes and environment details that
# do not belong in a public repo. They stay on disk; they are never committed.
PROGRESS.md
Carbon R Project Checklist.md

# OS / editor
.DS_Store
.idea/
.vscode/
